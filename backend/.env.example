# Copy to backend/.env and fill in real values. Never commit .env.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fitfinder

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=1440
REMEMBER_ME_DAYS=30

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost"]
FRONTEND_URL=http://localhost:5173

# Cloudinary (optional — photos are analysed but not stored when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sign-In (optional) — OAuth 2.0 Web client ID
GOOGLE_CLIENT_ID=
